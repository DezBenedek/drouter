{
  "name": "drouter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "drouter.dezso.hu/*",
      "zone_id": "a93d81d92342870ea117b2cbe4e821ac"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROUTERS",
        "class_name": "RouterRelay"
      },
      {
        "name": "REGISTRY",
        "class_name": "DeviceRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RouterRelay"
      ]
    },
    {
      "tag": "v2-registry",
      "new_sqlite_classes": [
        "DeviceRegistry"
      ]
    }
  ],
  "vars": {
    "DEV_ORIGIN": "http://127.0.0.1:5173"
  },
  "observability": {
    "enabled": false
  }
}
