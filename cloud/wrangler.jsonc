{
  "name": "drouter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ROUTERS", "class_name": "RouterRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RouterRelay"] }],
  "vars": { "DEV_ORIGIN": "http://127.0.0.1:5173" },
  "observability": { "enabled": false }
}
