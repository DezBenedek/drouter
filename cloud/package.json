{
  "name": "drouter-cloud",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "ui": "vite --host 127.0.0.1",
    "build": "npm run build:css && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "build:css": "node ../scripts/build-style.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@cloudflare/workers-types": "latest",
    "@picocss/pico": "2.1.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.17.1",
    "prettier": "^3.9.10",
    "sass": "1.93.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.44.0",
    "ws": "^8.18.3"
  }
}
